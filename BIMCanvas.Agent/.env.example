# BIMCanvas Agent Configuration
# Copy this file to .env and fill in your values

# Runtime Provider
# claude-sdk | openai-agents
AGENT_RUNTIME_PROVIDER=claude-sdk

# Claude Runtime
ANTHROPIC_API_KEY=your-api-key-here

# OpenAI Runtime (fill these when AGENT_RUNTIME_PROVIDER=openai-agents)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Model Configuration
# Default model is configured in <BIMCANVAS_HOME>/web_config.json
MAX_TOKENS=4096

# HTTP Server Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=8865

# Project Configuration (optional)
DEFAULT_PROJECT_PATH=
