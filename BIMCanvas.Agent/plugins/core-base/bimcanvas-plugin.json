{
  "$schema": "../../../../docs/plugin-manifest-schema.json",

  "name": "core-base",
  "version": "1.0.0",
  "compatibility": { "bimcanvas": "^1.0.0" },

  "displayName": "BIM 基础助手",
  "description": "BIMCanvas 平台基座 plugin。提供通用查询与机械编辑能力(只读统计、移动/删除/旋转),不绑定任何业务 domain;可与任何 domain plugin 共存。tools/agents 仅在无 active 专业插件时作为 fallback 生效。",

  "tools": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Bash",
      "Glob",
      "Grep",
      "Task",
      "Skill",
      "AskUserQuestion",
      "mcp__canvas__request_background_screenshot",
      "mcp__canvas__analyze_image",
      "mcp__canvas__create_job",
      "mcp__canvas__complete_job",
      "mcp__canvas__load_artifact",
      "mcp__canvas__validate_layout"
    ],
    "deny": []
  },
  "agents": { "allow": [], "deny": [] }
}
