# BIMCanvas Docker local smoke-test variables
# Copy this file to deploy/.env before running the local overlay compose command.

# Use a host path without Chinese characters to avoid WSL2 bind mount issues.
BIMCANVAS_DATA_ROOT=C:/Users/<user>/Documents/bimcanvas-data

# Host port for the single local Web/API entrypoint.
BIMCANVAS_HTTP_PORT=16001
