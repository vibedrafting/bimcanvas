# BIMCanvas Docker Compose shared variables for Linux server deployment.
# Copy this file to deploy/.env before running docker compose.
# This file is only used for host-level path interpolation in docker-compose.yml.

# Shared host data root. Each instance stores its runtime state under:
#   /srv/bimcanvas-data/alice
#   /srv/bimcanvas-data/bob
BIMCANVAS_DATA_ROOT=/srv/bimcanvas-data
