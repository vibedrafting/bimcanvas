# ===================================================
# BIMCanvas instance bootstrap variables
# Copy this file to instance-<name>.env before first deployment.
# This file only provides first-start defaults for /data/*.json.
# After bootstrap, long-term config lives in /data/*.json and the settings UI.
# ===================================================

# --- Required: choose one AI mode ---
# Recommended default: direct Anthropic-compatible mode.
# Uncomment the minimum fields you need below.

# --- Direct mode (recommended) ---
# Minimum required for first start:
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# Optional when using a compatible provider endpoint:
# ANTHROPIC_BASE_URL=https://your-provider-base-url

# --- CCR mode (advanced) ---
# Enable built-in CCR gateway.
# Requires a usable /data/ccr_config.json provider structure
# from a pre-seeded file or the settings UI.
# CCR_ENABLED=true
# CCR_MODEL_FAMILY=sonnet
# Optional single-provider override for an existing provider entry:
# CCR_API_KEY=your-provider-key
# CCR_API_BASE=https://your-provider-base-url
# Optional when ccr_config.json contains multiple providers:
# CCR_PROVIDER_NAME=your-provider-name

# --- Optional runtime overrides ---
# Default chat model written into web_config.json on first start.
# ANTHROPIC_MODEL=
#
# Runtime config root inside the container. Usually keep the default.
# BIMCANVAS_HOME=/data
#
# Optional only when Server still uses托管模式拉起本地 Agent。
# Docker 两容器部署会由 compose 自动注入 Agent 基址，不需要在这里填写。
# BIMCANVAS_PYTHON_COMMAND=python3

# --- Notes ---
# start.sh auto-sets:
# ASPNETCORE_ENVIRONMENT=Production
# ASPNETCORE_URLS=http://0.0.0.0:5000
# SERVER_HOST=0.0.0.0
# BIMCANVAS_WEB_URL=http://localhost:5000
#
# If Direct mode is active and no API key is available after bootstrap,
# update instance-*.env before first start or edit /data/config.json later.
# If CCR mode is active but provider entries are empty,
# edit /data/ccr_config.json or use the settings UI.
