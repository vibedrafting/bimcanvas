# ===================================================
# BIMCanvas instance environment template
# Copy this file to instance-<name>.env and fill values.
# ===================================================

# --- Secrets ---
# Direct Anthropic mode:
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_BASE_URL=https://your-provider-base-url

# CCR gateway mode:
# Requires a configured /data/ccr_config.json (via UI or pre-seeded file).
# CCR_ENABLED=true
# CCR_MODEL_FAMILY=sonnet
# Optional single-provider override for an existing provider entry:
# CCR_API_KEY=your-provider-key
# CCR_API_BASE=https://your-provider-base-url
# Optional when ccr_config.json has multiple providers:
# CCR_PROVIDER_NAME=your-provider-name
# For multi-provider routing, edit /data/ccr_config.json directly or use the settings UI.

# --- Paths ---
# BIMCANVAS_HOME=/data

# --- Image capabilities ---
# The image already includes:
# - Python + BIMCanvas.Agent runtime dependencies
# - Claude Code CLI (`claude`)
# - Claude Code Router (`ccr`)
# Usually you do not need to override command paths manually.

# --- Optional runtime overrides ---
# ANTHROPIC_MODEL=
# BIMCANVAS_PYTHON_COMMAND=/app/BIMCanvas.Agent/venv/bin/python

# --- Auto-set by start.sh ---
# ASPNETCORE_ENVIRONMENT=Production
# ASPNETCORE_URLS=http://0.0.0.0:5000
# SERVER_HOST=0.0.0.0
# BIMCANVAS_WEB_URL=http://localhost:5000
# When CCR_ENABLED=true, the container uses the built-in CCR capability.
