<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="8.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.22" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.NewtonsoftJson" Version="10.0.2" />
    <PackageReference Include="Microsoft.Playwright" Version="1.42.0" />
    <PackageReference Include="Newtonsoft.Json.Schema" Version="4.0.1" />
    <PackageReference Include="SharpCompress" Version="0.44.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="System.Management" Version="8.0.0" Condition="'$(OS)' == 'Windows_NT'" />
    <PackageReference Include="YamlDotNet" Version="15.1.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BIMCanvas.Core\BIMCanvas.Core.csproj" />
  </ItemGroup>

  <!-- Scripts/ 子目录是独立 CLI 工具的 .csproj，必须排除在 Server 编译范围外 -->
  <ItemGroup>
    <Compile Remove="Scripts\**\*.cs" />
    <Content Remove="Scripts\**\*" />
    <None Remove="Scripts\**\*" />
    <EmbeddedResource Remove="Scripts\**\*" />
  </ItemGroup>

  <!-- Agent 模板/资源文件：复制到输出目录 -->
  <ItemGroup>
    <Content Remove="Templates\**\*" />
    <None Remove="Templates\**\*" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Templates\**\*"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 示例项目文件：发布时复制到 publish/demos -->
  <ItemGroup>
    <Content Include="..\demos\**\*" LinkBase="demos" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Plugin JSONSchema 资源：StaticPluginValidator 运行时从 Schemas/ 目录加载 -->
  <ItemGroup>
    <Content Include="..\docs\plugin-manifest-schema.json"
             LinkBase="Schemas"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\docs\bcp-scenes-schema.json"
             LinkBase="Schemas"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
