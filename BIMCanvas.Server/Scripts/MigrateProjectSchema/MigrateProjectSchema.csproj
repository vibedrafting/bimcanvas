<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>BIMCanvas.Scripts.MigrateProjectSchema</RootNamespace>
    <AssemblyName>MigrateProjectSchema</AssemblyName>
    <!--
      CLI 复用 Server 端 ProjectHealth 服务代码（通过 Compile Include 链接源码），
      保持独立编译，不引 BIMCanvas.Server.csproj 整体 ASP.NET 依赖。
      Phase 0  semantic_plan / reference_analysis 字段重命名（Version → Tag 等）
      Phase 0b modules.json 裸数组 → wrapper {schemeMetadata, modules}
    -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- 链接 Server 端 ProjectHealth 源码；Server.csproj 已经把 Scripts/ 整目录从自身编译排除，互不影响 -->
    <Compile Include="..\..\Services\ProjectHealth\IProjectHealthCheck.cs"
             Link="Linked\IProjectHealthCheck.cs" />
    <Compile Include="..\..\Services\ProjectHealth\ProjectHealthService.cs"
             Link="Linked\ProjectHealthService.cs" />
    <Compile Include="..\..\Services\ProjectHealth\Checks\SemanticPlanTagCheck.cs"
             Link="Linked\Checks\SemanticPlanTagCheck.cs" />
    <Compile Include="..\..\Services\ProjectHealth\Checks\ModulesWrapperCheck.cs"
             Link="Linked\Checks\ModulesWrapperCheck.cs" />
    <Compile Include="..\..\Services\ProjectHealth\Checks\SemanticPlanTagValueCheck.cs"
             Link="Linked\Checks\SemanticPlanTagValueCheck.cs" />
    <Compile Include="..\..\Services\ProjectHealth\Checks\SchemeMetadataSlimCheck.cs"
             Link="Linked\Checks\SchemeMetadataSlimCheck.cs" />
    <Compile Include="..\..\Services\ProjectHealth\Checks\PointerModelMigrateCheck.cs"
             Link="Linked\Checks\PointerModelMigrateCheck.cs" />
    <!-- 注意：不链接 GitWorktreeServiceCommitter.cs—— CLI 不需要 git 兜底（用户手动 git 存档）-->
  </ItemGroup>
</Project>
