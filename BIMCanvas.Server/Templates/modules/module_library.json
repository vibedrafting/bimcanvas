    {
      "id": "mod_bed_001",
      "name": "凤栖湖大床",
      "tags": [
        "sleep"
      ],
      "size": {
        "width": 1800,
        "depth": 2100
      },
      "agent_config": {
        "morphology": {
          "strategy": "fixed"
        },
        "topology_rules": [
          "整组睡眠家具（床+床头柜）需靠墙放置",
          "床头必须靠实墙（禁止靠窗墙或门墙）",
          "严格避让门的开启扇区域"
        ],
        "relation_rules": [
          "【核心布局】侧对窗户：床头靠侧墙（非窗墙），床的长边朝向窗户方向——这是次卧/主卧的首选布局",
          "多面实墙可选时，床头优先靠离门最远的墙面（隐私与动线最优）",
          "【硬约束】若靠近窗户墙放置，需预留200mm窗帘安装空间",
          "间距分配参照 placement_guide §7.6",
          "【成套要求】主卧应成对配套床头柜（bedroom_core 依赖组）；次卧至少一个（优先远离窗户侧）。省略条件参照 placement_guide §7.6"
        ]
      },
      "description": "凤栖湖定制1800床",
      "svgPath": "assets/mod_bed_001.svg"
    },
    {
      "id": "mod_cabinet_001",
      "name": "床头柜",
      "tags": [
        "sleep"
      ],
      "size": {
        "width": 450,
        "depth": 400
      },
      "agent_config": {
        "morphology": {
          "strategy": "fixed"
        },
        "topology_rules": [
          "必须紧贴床头两侧"
        ],
        "relation_rules": [
          "【必须放置】卧室中应至少布置一个床头柜（bedroom_core 成套），省略条件参照 placement_guide §7.6",
          "【建议】主卧优先成对布置（对称布局）。",
          "【提示】床头柜与相邻家具（如衣柜）之间的间隙是使用间隙，不适用通道宽度标准；相邻衣柜空间不足时应选用移门"
        ]
      },
      "description": "凤栖湖450床头柜",
      "svgPath": "assets/mod_cabinet_001.svg"
    },
    {
      "id": "mod_cabinet_custom_001",
      "name": "定制柜体",
      "tags": [
        "generalStorage",
        "wardrobeStorage"
      ],
      "size": {
        "width": 800,
        "depth": 600
      },
      "agent_config": {
        "morphology": {
          "strategy": "parametric",
          "limits": {
            "width": [
              800,
              1200
            ],
            "depth": [
              600,
              1200
            ]
          }
        },
        "topology_rules": [
          "【必须】靠墙放置",
          "【必须】严格避让门的开启扇区域",
          "【建议】门扇类型选择：空间充裕（前方净空≥600mm）时用平开门；空间紧张（前方净空<600mm）时用移门/滑门（无需前方开门空间）"
        ],
        "relation_rules": [
          "【建议】可成对布置形成步入式通道",
          "【建议】当房间存在入户门后方的凹位墙面（深度≥600mm、宽度≥800mm）时，优先将定制柜体布置于此",
          "【必须】作为标准柜体阵列后的补充，填充有效段剩余空间；作为衣柜补充件时 depth 应与主柜体一致（通常 600mm）——深度一致使柜面齐平，避免视觉断裂",
          "【提示】选择移门时需在placementReason和items.familyName中注明",
          "【必须】布置后检查两侧墙面剩余空间，若某侧<600mm且非门口/通道侧，应将柜体组整体平移贴靠该侧墙角",
          "【必须】在卧室中作为衣柜使用时，墙面选择参照 placement_guide §7.4"
        ]
      },
      "description": "凤栖湖定制柜体(宽<1500)",
      "svgPath": "assets/mod_cabinet_custom_001.svg"
    },
