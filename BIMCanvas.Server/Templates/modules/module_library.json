  "modules": [
    {
      "id": "mod_bed_001",
      "name": "凤栖湖大床",
      "tags": [
        "sleep"
      ],
      "size": {
        "width": 1800,
        "depth": 2100
      },
      "agent_config": {
        "morphology": {
          "strategy": "fixed"
        },
        "topology_rules": [
          "整组睡眠家具（床+床头柜）需靠墙放置——释放中央活动区域，床头贴墙提供心理安全感",
          "床头必须靠实墙（禁止靠窗墙或门段——门段 = 门洞 + 两侧各 500mm 缓冲；同一面墙上远离门的实墙段仍可作为床头）",
          "严格避让门的开启扇区域"
        ],
        "relation_rules": [
          "【核心布局】侧对窗户：床的长边朝向窗户方向——次卧/主卧首选布局",
          "多面实墙可选时，床头优先靠离门最远的墙面——睡眠区与入口动线隔开，减少进出干扰",
          "【硬约束】若靠近窗户墙放置，需预留200mm窗帘安装空间",
          "【建议】间距分配：先为两侧床头柜各预留 ≥ 其深度的空间（窗侧在窗帘之外），剩余空间偏向使用侧",
          "【成套要求】主卧应成对配套床头柜（bedroom_core 依赖组）；次卧至少一个（优先远离窗户侧）。紧凑空间（使用侧 < 500mm）可省略窗侧床头柜"
        ]
      },
      "description": "凤栖湖定制1800床",
      "svgPath": "assets/mod_bed_001.svg"
    },
    {
      "id": "mod_cabinet_001",
      "name": "床头柜",
      "tags": [
        "sleep"
      ],
      "size": {
        "width": 450,
        "depth": 400
      },
      "agent_config": {
        "morphology": {
          "strategy": "fixed"
        },
        "topology_rules": [
          "必须紧贴床头两侧"
        ],
        "relation_rules": [
          "【必须放置】卧室中应至少布置一个床头柜（bedroom_core 成套），仅在两侧都放下后使用侧 < 500mm 时可省略窗侧",
          "【建议】主卧优先成对布置（对称布局）。",
          "【提示】床头柜与相邻家具（如衣柜）之间的间隙是使用间隙，不适用通道宽度标准；相邻衣柜空间不足时应选用移门"
        ]
      },
      "description": "凤栖湖450床头柜",
      "svgPath": "assets/mod_cabinet_001.svg"
    },
    {
      "id": "mod_cabinet_custom_001",
      "name": "定制柜体",
      "tags": [
        "generalStorage",
        "wardrobeStorage"
      ],
      "size": {
        "width": 800,
        "depth": 600
      },
      "agent_config": {
        "morphology": {
          "strategy": "parametric",
          "limits": {
            "width": [
              600,
              1200
            ],
            "depth": [
              600,
              1200
            ]
          }
        },
        "topology_rules": [
          "【必须】靠墙放置",
          "【必须】严格避让门的开启扇区域",
          "【建议】门扇类型选择：前方净空 ≥ 600mm 用平开门；< 600mm 用移门/滑门（无需前方开门空间）"
        ],
        "relation_rules": [
          "【建议】可成对布置形成步入式通道",
          "【建议】当房间存在入户门后方的凹位墙面（深度≥600mm、宽度≥800mm）时，优先将定制柜体布置于此",
          "【必须】作为标准柜体阵列后的补充，填充有效段剩余空间；作为衣柜补充件时 depth 应与主柜体一致（通常 600mm）——深度一致使柜面齐平，避免视觉断裂",
          "【提示】选择移门时需在placementReason和items.familyName中注明",
          "【必须】布置后检查两侧墙面剩余空间，若某侧<600mm且非门口/通道侧，应将柜体组整体平移贴靠该侧墙角——窄缝无法使用又难清洁（同顶角规则）",
          "【必须】在卧室中作为衣柜使用时，先评估 L 形布局——根据卫生间门与转角的位置关系选择布局方式：门远离转角→传统布局（沿墙段+垂直隔断段），门紧邻转角→L型靠墙（两段贴墙）。L型靠墙须检查内角门开启遮挡。传统布局：沿墙段≥1000mm+垂直段≥600mm；L型靠墙：两段各≥600mm且至少一段≥1200mm。有效段按 exclusion zone 计算。条件不满足时回退为线性布局（排除窗墙+床组占据段，选有效段最长者；对面墙通道<800mm须换墙）"
        ]
      },
      "description": "凤栖湖定制柜体(宽<1500)",
      "svgPath": "assets/mod_cabinet_custom_001.svg"
    },
