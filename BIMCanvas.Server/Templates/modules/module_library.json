      "id": "mod_bed_001",
      "name": "凤栖湖大床",
      "tags": [
        "sleep"
      ],
      "size": {
        "width": 1800,
        "depth": 2100
      },
      "agent_config": {
        "morphology": {
          "strategy": "fixed"
        },
        "topology_rules": [
          "整组睡眠家具（床+床头柜）需靠墙放置",
          "严格避让门的开启扇区域"
        ],
        "relation_rules": [
          "优先侧对窗户布局：床头靠侧墙，床的长边朝向窗户方向，兼顾隐私与自然采光",
          "若靠近窗户墙放置，需预留200mm窗帘安装空间",
          "紧凑房型中，优先保证远离窗户一侧的通道畅通（≥500mm），窗侧床边间距可缩减至窗帘预留距离"
        ]
      },
      "description": "凤栖湖定制1800床",
      "svgPath": "assets/mod_bed_001.svg"
    },
