{
  "server": {
    "port": 8865
  },
  "startup": {
    "openBrowser": true,
    "browserPath": null
  },
  "liteLlm": {
    "enabled": true,
    "autoStart": true,
    "host": "127.0.0.1",
    "port": 4000,
    "pythonCommand": "python",
    "activeProvider": "gemini_yescode",
    "defaultModelFamily": "sonnet",
    "configFileName": "litellm_config.yaml"
  },
  "ccr": {
    "enabled": true,
    "autoStart": true,
    "host": "127.0.0.1",
    "port": 3456,
    "configFileName": "ccr_config.json"
  },
  "providerAdapter": {
    "enabled": true,
    "autoStart": true,
    "host": "127.0.0.1",
    "port": 4101,
    "runtimeLiteLlmConfigFileName": "litellm_runtime.generated.yaml",
    "runtimeAdapterConfigFileName": "provider_adapter_runtime.generated.json",
    "mappings": [
      {
        "providerAlias": "anthropic_proxy",
        "mode": "direct"
      },
      {
        "providerAlias": "gemini_yescode",
        "mode": "adapter",
        "profile": "gemini_native_v1beta"
      },
      {
        "providerAlias": "gemini_sub2api",
        "mode": "direct"
      }
    ]
  }
}
