<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BIMCanvas.Server.JObjectPatchSpike</RootNamespace>
    <AssemblyName>BIMCanvas.Server.JObjectPatchSpike</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- 与 BIMCanvas.Server 通过 Microsoft.AspNetCore.Mvc.NewtonsoftJson 8.0.0 引入的 Newtonsoft 主版本对齐 -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
